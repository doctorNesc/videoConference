# Video Conference Application - Environment Configuration
# Copy this file to .env and update with your values

# Application Environment
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Database Configuration (if applicable)
# DATABASE_URL=postgresql://user:password@localhost:5432/videoconference
# DATABASE_POOL_SIZE=10

# API Configuration
API_TIMEOUT=30000
API_MAX_REQUEST_SIZE=20mb

# Socket.IO Configuration
SOCKET_IO_CORS_ORIGIN=*
SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_PING_TIMEOUT=60000

# Mediasoup Configuration
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=auto
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# Security
JWT_SECRET=your-secret-key-here-change-in-production
SESSION_SECRET=your-session-secret-here-change-in-production
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_FORMAT=json
LOG_LEVEL=info

# Feature Flags
ENABLE_RECORDING=false
ENABLE_TRANSCRIPTION=false
ENABLE_ANALYTICS=true

# Email Configuration (if applicable)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@videoconference.com

# AWS Configuration (if using AWS services)
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name

# Redis Configuration (if using Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Monitoring and Analytics
# SENTRY_DSN=
# DATADOG_API_KEY=
# NEW_RELIC_LICENSE_KEY=

# Custom Configuration
# Add your custom environment variables below
